processor SpikeFx [[ main ]]
{
    input stream float<2> in;
    output stream float<2> out;
    input value float gain [[ name: "Level", min: 0.0, max: 2.0, init: 1.0 ]];
    input value float tilt [[ name: "Tilt", min: -1.0, max: 1.0, init: 0.25 ]];
    void main() { loop { let x = in; out <- float<2> (x[0] * gain * (1.0f - tilt), x[1] * gain * (1.0f + tilt)); advance(); } }
}
